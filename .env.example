# Voxmancer Configuration

# ============================================================================
# TTS Backend (Choose ONE)
# ============================================================================

# CPU-friendly (default, recommended for local)
TTS_BACKEND=piper

# GPU-optimized (for Runpod)
# TTS_BACKEND=parler

# Voice cloning (record yourself)
# TTS_BACKEND=coqui
# COQUI_GPU=true

# Cloud API
# TTS_BACKEND=elevenlabs
# ELEVENLABS_API_KEY=sk_your_key_here

# ============================================================================
# LLM Backend (Choose ONE)
# ============================================================================

# Local (default, no API key needed)
LLM_BACKEND=ollama
OLLAMA_URL=http://localhost:11434
LLM_MODEL=mistral

# Cloud API
# LLM_BACKEND=anthropic
# ANTHROPIC_API_KEY=sk_ant_your_key_here
# LLM_MODEL=claude-3-5-sonnet-latest

# ============================================================================
# Start Ollama if using local LLM
# ============================================================================
# ollama serve
# ollama pull mistral
